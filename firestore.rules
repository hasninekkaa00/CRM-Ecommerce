rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isSignedIn() { return request.auth != null; }

    match /users/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /confirmerInvoices/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /orders/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /abandonedOrders/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /campaigns/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /campaignRecords/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /campaignFields/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /salesChannels/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /settings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /expenses/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /partners/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /partnerTransactions/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /inventory/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /suppliers/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /purchaseInvoices/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /supplierPayments/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /shippingInvoices/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /shippingBureaus/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /notes/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /inventoryMovements/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
